{
  "name": "i18n-agent",
  "description": "🌍 i18n-agent MCP Client - 48 languages, AI-powered translation for Claude Code. Professional translation service with context-aware translations, file translation support, and 48 language variants.",
  "version": "1.15.0",
  "author": {
    "name": "FatCouple OÜ",
    "email": "support@i18nagent.ai"
  },
  "homepage": "https://i18nagent.ai",
  "repository": "https://github.com/i18n-agent/mcp-client",
  "license": "MIT",
  "keywords": [
    "i18n",
    "translation",
    "mcp",
    "claude",
    "ai",
    "internationalization",
    "localization",
    "multilingual"
  ],
  "mcpServers": {
    "i18n-agent": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/i18n-agent.js"],
      "env": {
        "MCP_SERVER_URL": "https://mcp.i18nagent.ai",
        "API_KEY": "${API_KEY}"
      },
      "disabled": false
    }
  },
  "hooks": {
    "PostPluginInstall": [
      {
        "type": "command",
        "command": "bash",
        "args": ["-c", "cd ${CLAUDE_PLUGIN_ROOT} && npm install --production --silent"]
      }
    ]
  }
}
